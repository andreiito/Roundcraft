---
// "Open in RoundCraft" button. Fires the roundcraft://import deep link and, if
// nothing takes over the page, falls back to the Play Store: a visitor without
// the app installed sees a store page instead of a dead tap.
import Icon from './Icon.astro';
import { playUrl } from '../data/site';

interface Props {
  target: string;
  label: string;
  campaign: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { target, label, campaign, variant = 'primary', class: className = '' } = Astro.props;
---
<button
  type="button"
  class={`btn btn-${variant} open-in-app ${className}`}
  data-deeplink={target}
  data-fallback={playUrl(campaign)}
>
  <Icon name="arrow" size={17} /> {label}
</button>

<style>
  .open-in-app { justify-content: center; }
</style>

<script>
  // A deep link to an app that is not installed fails silently on Android: the
  // navigation is simply ignored. There is no event for that, so the signal is
  // the inverse: if the app DOES open, the page is hidden or loses focus. Still
  // visible after the grace period means no app, so send them to the store.
  const GRACE_MS = 1400;

  document.querySelectorAll<HTMLButtonElement>('.open-in-app').forEach((btn) => {
    btn.addEventListener('click', () => {
      const deeplink = btn.dataset.deeplink;
      const fallback = btn.dataset.fallback;
      if (!deeplink) return;

      let leftPage = false;
      const markLeft = () => { leftPage = true; };
      window.addEventListener('pagehide', markLeft, { once: true });
      window.addEventListener('blur', markLeft, { once: true });
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'hidden') markLeft();
      }, { once: true });

      window.location.href = deeplink;

      if (fallback) {
        window.setTimeout(() => {
          if (!leftPage && document.visibilityState === 'visible') {
            window.location.href = fallback;
          }
        }, GRACE_MS);
      }
    });
  });

  // QR codes and shared links can append ?open=app to jump straight into the
  // app, skipping the tap. Only the first button on the page is auto-fired.
  const params = new URLSearchParams(window.location.search);
  if (params.get('open') === 'app') {
    const first = document.querySelector<HTMLButtonElement>('.open-in-app');
    if (first) window.setTimeout(() => first.click(), 400);
  }
</script>
