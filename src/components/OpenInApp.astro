---
// "Open in RoundCraft": hands a pattern to the app through its import deep
// link, roundcraft://import?u=<url of the .rcpattern>.
//
// Two things make this less obvious than it looks:
//
// 1. Chrome on Android refuses to navigate to a custom scheme from JavaScript.
//    The supported route is an intent:// URI, which also carries its own
//    browser_fallback_url, so Chrome sends people without the app to the Play
//    Store itself. No timers, no guessing whether the app opened.
// 2. RoundCraft is Android only. On anything else the honest destination for
//    this button is the store listing.
import Icon from './Icon.astro';
import { playUrl, PLAY_STORE_ID } from '../data/site';

interface Props {
  /** Absolute URL of the .rcpattern file. Must satisfy the app's import
   *  allow-list, which is checked against this string before it is fetched. */
  fileUrl: string;
  label: string;
  campaign: string;
  /** Slug reported with the click, so "which pattern converts" is answerable. */
  pattern?: string;
  variant?: 'primary' | 'ghost';
  class?: string;
}
const { fileUrl, label, campaign, pattern, variant = 'primary', class: className = '' } = Astro.props;

const store = playUrl(campaign);
const query = `u=${encodeURIComponent(fileUrl)}`;
const intentUrl =
  `intent://import?${query}#Intent;scheme=roundcraft;package=${PLAY_STORE_ID};` +
  `S.browser_fallback_url=${encodeURIComponent(store)};end`;
---
<button
  type="button"
  class={`btn btn-${variant} open-in-app ${className}`}
  data-intent={intentUrl}
  data-store={store}
  data-track="open_in_app"
  data-track-pattern={pattern}
>
  <Icon name="arrow" size={17} /> {label}
</button>

<style>
  .open-in-app { justify-content: center; }
</style>

<script>
  const isAndroid = /android/i.test(navigator.userAgent);

  const open = (btn: HTMLButtonElement) => {
    const target = isAndroid ? btn.dataset.intent : btn.dataset.store;
    if (target) window.location.href = target;
  };

  document.querySelectorAll<HTMLButtonElement>('.open-in-app').forEach((btn) => {
    btn.addEventListener('click', () => open(btn));
  });

  // QR codes and shared links can append ?open=app to skip the tap.
  if (new URLSearchParams(window.location.search).get('open') === 'app') {
    const first = document.querySelector<HTMLButtonElement>('.open-in-app');
    if (first) window.setTimeout(() => open(first), 400);
  }
</script>
