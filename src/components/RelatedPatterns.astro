---
import { localizedPath, type Lang } from '../i18n/utils';
import { related, SERIES, type Pattern } from '../data/patterns';

interface Props { lang: Lang; pattern: Pattern; }
const { lang, pattern } = Astro.props;

const { series, alsoLike } = related(pattern);
const href = (slug: string) => `${localizedPath('/patterns', lang)}/${slug}`;

const ui = {
  en: { alsoLike: 'You might also like', more: (g: string) => `More ${g.toLowerCase()}` },
  es: { alsoLike: 'También te puede gustar', more: (g: string) => `Más ${g.toLowerCase()}` },
}[lang];

// The series strip is titled with the group's own name -- "More cats" says what
// the row is far better than a generic heading, and it is the phrase the reader
// already has in mind after looking at a cat.
const groups = [
  ...(series.length && pattern.series
    ? [{ key: 'series', title: ui.more(SERIES[pattern.series][lang]), items: series }]
    : []),
  ...(alsoLike.length ? [{ key: 'also', title: ui.alsoLike, items: alsoLike }] : []),
];
---
{groups.map((g) => (
  <div class="rel" data-reveal>
    <h2>{g.title}</h2>
    <ul class="rel-strip">
      {g.items.map((p) => (
        <li>
          <a href={href(p.slug)} data-track="related_pattern" data-track-pattern={p.slug}>
            <img src={p.preview} width={p.previewW} height={p.previewH}
              loading="lazy" decoding="async"
              alt={`Tapestry crochet chart: ${p.name}`} />
            <span class="rel-name">{p.name}</span>
            <span class="rel-meta">{p.meta[lang]}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
))}

<style>
  .rel { margin-bottom: 1.8rem; }
  .rel h2 { font-size: var(--fs-md); margin-bottom: 0.9rem; }

  /* A scroll strip rather than a grid: it keeps the row to one line at every
     width, so the recommendations never push the app block off the screen on a
     phone, and horizontal scroll is the gesture this pattern of row teaches. */
  .rel-strip {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    margin: 0;
    list-style: none;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
  }
  .rel-strip::-webkit-scrollbar { height: 6px; }
  .rel-strip::-webkit-scrollbar-thumb { background: var(--line); border-radius: 3px; }

  .rel-strip li { flex: 0 0 128px; scroll-snap-align: start; }
  .rel-strip a { display: block; color: inherit; }
  .rel-strip img {
    width: 100%;
    height: auto;
    border-radius: var(--r-md, 10px);
    border: 1px solid var(--line);
    background: var(--paper, #fff);
    display: block;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .rel-strip a:hover img { transform: translateY(-2px); box-shadow: var(--shadow-md); }
  .rel-name {
    display: block;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.92rem;
    line-height: 1.25;
  }
  .rel-meta { display: block; font-size: 0.8rem; color: var(--ink-soft); }

  @media (prefers-reduced-motion: reduce) {
    .rel-strip img { transition: none; }
    .rel-strip a:hover img { transform: none; }
  }
</style>
