---
import { alternatePath, type Lang } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pathname: string;
  ogImage?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  lang,
  pathname,
  ogImage = '/og-image.png',
  noindex = false,
} = Astro.props;

const site = 'https://getroundcraft.com';
// Match the physical build.format:'preserve' output: directory-index routes keep
// a trailing slash (they are <dir>/index.html); every other route is a real .html
// file served without a trailing slash. Astro.url can report a trailing slash on
// named routes, which would make canonicals point at a 404, so normalize here.
const DIR_INDEX = new Set(['/', '/es/', '/patterns/', '/es/patterns/']);
function canonicalize(pn: string): string {
  const withSlash = pn.endsWith('/') ? pn : pn + '/';
  return DIR_INDEX.has(withSlash) ? withSlash : pn.replace(/\/+$/, '');
}
const path = canonicalize(pathname);
const canonical = new URL(path, site).href;
const enHref = new URL(alternatePath(path, 'en'), site).href;
const esHref = new URL(alternatePath(path, 'es'), site).href;
const ogUrl = new URL(ogImage, site).href;

// Both are empty until an id is pasted into src/data/analytics.ts, and nothing
// third-party loads while they are.
import { CF_BEACON_TOKEN, GA4_ID } from '../data/analytics';
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="es" href={esHref} />
<link rel="alternate" hreflang="x-default" href={enHref} />

<meta name="theme-color" content="#FBF7EF" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#17110C" media="(prefers-color-scheme: dark)" />

<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
<link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<!-- The manifest declares the Play Store app as a related application and sets
     prefer_related_applications, so Chrome on Android stops offering to install
     the site. Without those two fields it installed the website as a PWA under
     the same name and icons as the real app, which is indistinguishable on the
     home screen and opens the web instead. Do not drop them. -->
<link rel="manifest" href="/manifest.webmanifest" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="RoundCraft" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{/* Set theme before first paint to avoid a flash of the wrong palette. */}
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('rc-theme');
      if (t === 'light' || t === 'dark') {
        document.documentElement.setAttribute('data-theme', t);
      }
    } catch (e) {}
  })();
</script>

{CF_BEACON_TOKEN && (
  <script
    is:inline
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
  />
)}

{GA4_ID && (
  <Fragment>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />
    <script is:inline define:vars={{ GA4_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA4_ID);
    </script>
  </Fragment>
)}

{GA4_ID && (
  <script is:inline>
    // One delegated listener for every tracked action, so counting a new one is
    // a data-track attribute rather than a change here. Clicks are reported with
    // the pattern slug when the element carries one, which is what makes
    // "which pattern converts" answerable.
    document.addEventListener('click', (e) => {
      const el = e.target instanceof Element ? e.target.closest('[data-track]') : null;
      if (!el || typeof window.gtag !== 'function') return;
      window.gtag('event', el.getAttribute('data-track'), {
        pattern: el.getAttribute('data-track-pattern') || undefined,
        lang: document.documentElement.lang || undefined,
      });
    });
  </script>
)}
