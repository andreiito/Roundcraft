---
import Icon from './Icon.astro';
import OpenInApp from './OpenInApp.astro';
import { useTranslations, localizedPath, type Lang } from '../i18n/utils';
import { playUrl } from '../data/site';
import { patterns, activeTags, TAGS } from '../data/patterns';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const tt = useTranslations(lang);
const tags = activeTags(patterns);

const copy = {
  en: {
    eyebrow: 'Free patterns',
    title: 'Free patterns to crochet and keep.',
    lede: 'Crochet charts, printables and free patterns by NaredCraft, in English and Spanish. Open one straight in the app, or download the PDF to print.',
    searchLabel: 'Search patterns',
    searchPlaceholder: 'Search by name, theme or tag…',
    filterLabel: 'Filter by tag',
    all: 'All',
    countOne: '1 pattern',
    countMany: '{n} patterns',
    empty: 'Nothing matches that yet.',
    emptyHint: 'Try another word, or clear the filters.',
    clear: 'Clear filters',
    pagerLabel: 'Pattern pages',
    prev: 'Previous page',
    next: 'Next page',
    pageLabel: 'Page {n}',
    free: 'Free',
    openInApp: 'Open in RoundCraft',
    details: 'Pattern details',
    appTitle: 'The app behind the patterns',
    appPitch: 'Follow any chart stitch by stitch with the built-in tapestry counter, then time and price your finished piece.',
    appCta: 'See what RoundCraft does',
  },
  es: {
    eyebrow: 'Patrones gratis',
    title: 'Patrones gratis para tejer y quedarte.',
    lede: 'Charts de crochet, imprimibles y patrones gratuitos de NaredCraft, en inglés y español. Abre uno directo en la app o descarga el PDF para imprimir.',
    searchLabel: 'Buscar patrones',
    searchPlaceholder: 'Busca por nombre, tema o etiqueta…',
    filterLabel: 'Filtrar por etiqueta',
    all: 'Todos',
    countOne: '1 patrón',
    countMany: '{n} patrones',
    empty: 'Todavía no hay nada que coincida.',
    emptyHint: 'Prueba con otra palabra o quita los filtros.',
    clear: 'Quitar filtros',
    pagerLabel: 'Páginas de patrones',
    prev: 'Página anterior',
    next: 'Página siguiente',
    pageLabel: 'Página {n}',
    free: 'Gratis',
    openInApp: 'Abrir en RoundCraft',
    details: 'Ver el patrón',
    appTitle: 'La app detrás de los patrones',
    appPitch: 'Sigue cualquier chart punto por punto con el contador tapestry integrado, luego cronometra y cotiza tu pieza terminada.',
    appCta: 'Mira qué hace RoundCraft',
  },
}[lang];

const detailHref = (slug: string) => `${localizedPath('/patterns', lang)}/${slug}`;

/** Everything the search box matches against, lowercased at build time. Both
 *  languages are indexed on purpose: plenty of Spanish speakers browse the
 *  English page, and "cow" should find the same pattern as "vaca". */
const haystack = (slug: string) => {
  const p = patterns.find((x) => x.slug === slug)!;
  const fromLocales = (['en', 'es'] as const).flatMap((l) => [
    p.locales[l].subtitle,
    p.locales[l].about,
    p.locales[l].seoDesc,
  ]);
  const tagWords = p.tags.flatMap((t) => [t, TAGS[t].en, TAGS[t].es]);
  return [p.name, p.slug.replace(/-/g, ' '), ...fromLocales, ...tagWords].join(' ').toLowerCase();
};
---
<section class="section">
  <div class="wrap">
    <header class="cat-head" data-reveal>
      <span class="eyebrow">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.lede}</p>
    </header>

    <div class="filters" data-reveal>
      <div class="search">
        <Icon name="search" size={18} class="search-icon" />
        <input
          type="search"
          id="pattern-search"
          class="search-input"
          placeholder={copy.searchPlaceholder}
          aria-label={copy.searchLabel}
          autocomplete="off"
        />
      </div>

      {tags.length > 0 && (
        <div class="chips" role="group" aria-label={copy.filterLabel}>
          <button type="button" class="chip is-on" data-tag="" aria-pressed="true">{copy.all}</button>
          {tags.map((id) => (
            <button type="button" class="chip" data-tag={id} aria-pressed="false">{TAGS[id][lang]}</button>
          ))}
        </div>
      )}

      <p class="count" id="pattern-count" aria-live="polite"
        data-one={copy.countOne} data-many={copy.countMany}>
        {patterns.length === 1 ? copy.countOne : copy.countMany.replace('{n}', String(patterns.length))}
      </p>
    </div>

    <div class="pattern-grid" id="pattern-grid" data-reveal>
      {patterns.map((p) => (
        <article class="pattern-card" data-slug={p.slug} data-tags={p.tags.join(' ')} data-text={haystack(p.slug)}>
          <a class="pc-media" href={detailHref(p.slug)}>
            <span class="pill-tag free">{copy.free}</span>
            <img src={p.preview} width="780" height="1320" loading="lazy" decoding="async"
              alt={`Tapestry crochet chart: ${p.name}`} />
          </a>
          <div class="pc-body">
            <h2><a href={detailHref(p.slug)}>{p.name}</a></h2>
            <span class="meta">{p.meta[lang]}</span>
            <ul class="pc-tags">
              {p.tags.map((id) => <li>{TAGS[id][lang]}</li>)}
            </ul>
            <div class="pc-actions">
              <OpenInApp fileUrl={p.deepLinkTarget} label={copy.openInApp} campaign={`catalog_${p.slug}`} pattern={p.slug} class="pc-open" />
              <a class="pc-details" href={detailHref(p.slug)}>{copy.details} <Icon name="arrow" size={16} /></a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <nav class="pager" id="pattern-pager" aria-label={copy.pagerLabel} data-page-label={copy.pageLabel} hidden>
      <button type="button" class="pg pg-arrow pg-prev" id="pattern-prev" aria-label={copy.prev}>
        <Icon name="arrow" size={16} />
      </button>
      <div class="pg-nums" id="pattern-pages"></div>
      <button type="button" class="pg pg-arrow" id="pattern-next" aria-label={copy.next}>
        <Icon name="arrow" size={16} />
      </button>
    </nav>

    <div class="empty" id="pattern-empty" hidden>
      <p class="empty-title">{copy.empty}</p>
      <p class="muted">{copy.emptyHint}</p>
      <button type="button" class="btn btn-ghost" id="pattern-clear">{copy.clear}</button>
    </div>

    <div class="app-card" data-reveal>
      <div>
        <h2>{copy.appTitle}</h2>
        <p class="lede">{copy.appPitch}</p>
      </div>
      <div class="app-actions">
        <a class="btn btn-primary" href={playUrl('patterns_index')} target="_blank" rel="noopener">{tt('cta.googlePlay')}</a>
        <a class="btn btn-ghost" href={localizedPath('/', lang)}>{copy.appCta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cat-head { max-width: 48ch; margin-bottom: clamp(1.6rem, 1rem + 2vw, 2.4rem); }
  .cat-head .eyebrow { margin-bottom: 0.9rem; }
  .cat-head h1 { margin-bottom: 0.8rem; }

  /* --- filters --- */
  .filters { margin-bottom: clamp(1.6rem, 1rem + 2vw, 2.4rem); }
  .search { position: relative; max-width: 420px; }
  .search :global(.search-icon) {
    position: absolute; left: 0.95rem; top: 50%; transform: translateY(-50%);
    color: var(--ink-faint); pointer-events: none;
  }
  .search-input {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.75em 1em 0.75em 2.7em;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .search-input::placeholder { color: var(--ink-faint); }
  .search-input:focus-visible {
    outline: none;
    border-color: var(--clay);
    box-shadow: 0 0 0 3px var(--clay-wash);
  }
  .search-input::-webkit-search-cancel-button { cursor: pointer; }

  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .chip {
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    padding: 0.45em 1em;
    cursor: pointer;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .chip:hover { border-color: var(--clay); color: var(--clay); }
  .chip.is-on {
    background: var(--clay-deep);
    border-color: var(--clay-deep);
    color: #fff;
  }
  .count { margin-top: 1rem; font-size: 0.9rem; color: var(--ink-faint); }

  /* --- grid --- */
  .pattern-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1.4rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .pattern-card {
    display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: 1rem; box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .pattern-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .pattern-card[hidden] { display: none; }

  .pc-media { position: relative; display: block; }
  /* Charts come in wildly different proportions, so the tile is fixed and the
     chart is contained inside it: cards stay the same height in a row and no
     part of the chart is ever cropped away. */
  .pc-media img {
    width: 100%; display: block;
    aspect-ratio: 4 / 5;
    object-fit: contain;
    background: var(--surface-2);
    border-radius: var(--r-sm); border: 1px solid var(--line);
  }
  .pc-media .free { position: absolute; top: 0.6rem; left: 0.6rem; background: var(--clay-deep); color: #fff; }

  .pc-body { display: flex; flex-direction: column; flex: 1; margin-top: 0.9rem; }
  .pc-body h2 { font-size: var(--fs-md); margin-bottom: 0.2rem; }
  .pc-body h2 a { color: var(--ink); }
  .pc-body h2 a:hover { color: var(--clay); }
  .pc-body .meta { font-size: 0.85rem; color: var(--ink-faint); }

  .pc-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.7rem 0 0; }
  .pc-tags li {
    font-size: 0.74rem; font-weight: 600; letter-spacing: 0.03em;
    color: var(--sage-text); background: var(--sage-wash);
    padding: 0.25em 0.65em; border-radius: var(--r-pill);
  }

  .pc-actions { margin-top: auto; padding-top: 1rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .pc-actions :global(.pc-open) { width: 100%; padding: 0.7em 1em; font-size: 0.92rem; }
  .pc-details {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    font-size: 0.9rem; font-weight: 600; color: var(--ink-soft);
  }
  .pc-details:hover { color: var(--clay); }
  .pc-details :global(.icon) { transition: transform var(--dur) var(--ease); }
  .pc-details:hover :global(.icon) { transform: translateX(3px); }

  /* --- pager ---
     The number buttons are built by the script below, so they carry no scope
     attribute: everything that has to reach them is written as :global() under
     the server-rendered .pager. */
  .pager {
    display: flex; align-items: center; justify-content: center; flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: clamp(2rem, 1.4rem + 2vw, 3rem);
  }
  .pager[hidden] { display: none; }
  .pg-nums { display: flex; align-items: center; gap: 0.4rem; }

  .pager :global(.pg) {
    font: inherit; font-size: 0.92rem; font-weight: 600;
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 2.6rem; height: 2.6rem; padding: 0 0.7em;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    cursor: pointer;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .pager :global(.pg:hover:not(:disabled)) { border-color: var(--clay); color: var(--clay); }
  .pager :global(.pg:disabled) { opacity: 0.4; cursor: default; }
  .pager :global(.pg.is-on) { background: var(--clay-deep); border-color: var(--clay-deep); color: #fff; }
  .pager :global(.pg-prev .icon) { transform: rotate(180deg); }
  .pager :global(.pg-gap) { color: var(--ink-faint); padding: 0 0.15rem; user-select: none; }

  @media (max-width: 480px) {
    .pager { gap: 0.3rem; }
    .pg-nums { gap: 0.3rem; }
    .pager :global(.pg) { min-width: 2.3rem; height: 2.3rem; padding: 0 0.5em; font-size: 0.86rem; }
  }

  /* --- empty --- */
  .empty { text-align: center; padding: clamp(2.5rem, 2rem + 3vw, 4rem) 1rem; }
  .empty-title { font-family: var(--font-display); font-size: var(--fs-lg); color: var(--ink); margin-bottom: 0.5rem; }
  .empty .btn { margin-top: 1.4rem; }

  .app-card {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap;
    background: var(--bg-tint); border: 1px solid var(--line);
    border-radius: var(--r-lg); padding: clamp(1.6rem, 1rem + 2vw, 2.4rem);
  }
  .app-card > div:first-child { max-width: 46ch; }
  .app-card h2 { font-size: var(--fs-lg); margin-bottom: 0.6rem; }
  .app-actions { display: flex; gap: 0.7rem; flex-wrap: wrap; }
</style>

<script>
  // Client-side filtering + pagination. The whole catalog ships in the HTML, so
  // filtering is instant, search still spans every pattern rather than the page
  // you happen to be on, and with JavaScript disabled the page lists them all.
  const PER_PAGE = 9;

  const grid = document.getElementById('pattern-grid');
  const search = document.getElementById('pattern-search') as HTMLInputElement | null;
  const countEl = document.getElementById('pattern-count');
  const emptyEl = document.getElementById('pattern-empty');
  const clearBtn = document.getElementById('pattern-clear');
  const pager = document.getElementById('pattern-pager');
  const numsEl = document.getElementById('pattern-pages');
  const prevBtn = document.getElementById('pattern-prev') as HTMLButtonElement | null;
  const nextBtn = document.getElementById('pattern-next') as HTMLButtonElement | null;

  if (grid && countEl) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.pattern-card'));
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
    const one = countEl.dataset.one || '1';
    const many = countEl.dataset.many || '{n}';
    const pageLabel = pager?.dataset.pageLabel || 'Page {n}';
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeTag = '';
    let page = readPage();

    function readPage() {
      const n = Number(new URLSearchParams(location.search).get('page'));
      return Number.isInteger(n) && n >= 1 ? n : 1;
    }

    /** Which numbers the row shows: all of them up to 7 pages, then first, last
     *  and current ±1 with the gaps collapsed to an ellipsis. */
    const pageItems = (total: number): (number | null)[] => {
      if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
      const wanted = [1, page - 1, page, page + 1, total]
        .filter((n) => n >= 1 && n <= total)
        .sort((a, b) => a - b);
      const out: (number | null)[] = [];
      let last = 0;
      for (const n of wanted) {
        if (n === last) continue;
        if (n - last > 1) out.push(null);
        out.push(n);
        last = n;
      }
      return out;
    };

    const renderPager = (total: number) => {
      if (!pager || !numsEl) return;
      pager.hidden = total <= 1;
      if (total <= 1) { numsEl.replaceChildren(); return; }
      if (prevBtn) prevBtn.disabled = page === 1;
      if (nextBtn) nextBtn.disabled = page === total;
      numsEl.replaceChildren(
        ...pageItems(total).map((n) => {
          if (n === null) {
            const gap = document.createElement('span');
            gap.className = 'pg-gap';
            gap.setAttribute('aria-hidden', 'true');
            gap.textContent = '…';
            return gap;
          }
          const b = document.createElement('button');
          b.type = 'button';
          b.className = n === page ? 'pg is-on' : 'pg';
          b.dataset.page = String(n);
          b.textContent = String(n);
          b.setAttribute('aria-label', pageLabel.replace('{n}', String(n)));
          if (n === page) b.setAttribute('aria-current', 'page');
          return b;
        }),
      );
    };

    const apply = () => {
      const q = (search?.value || '').trim().toLowerCase();
      const matched = cards.filter((card) => {
        const matchesTag = !activeTag || (card.dataset.tags || '').split(' ').includes(activeTag);
        const matchesText = !q || (card.dataset.text || '').includes(q);
        return matchesTag && matchesText;
      });

      const total = Math.max(1, Math.ceil(matched.length / PER_PAGE));
      if (page > total) page = total;
      const start = (page - 1) * PER_PAGE;
      const onPage = new Set(matched.slice(start, start + PER_PAGE));

      for (const card of cards) card.hidden = !onPage.has(card);

      countEl.textContent = matched.length === 1 ? one : many.replace('{n}', String(matched.length));
      if (emptyEl) emptyEl.hidden = matched.length !== 0;
      grid.hidden = matched.length === 0;
      renderPager(total);
    };

    /** ?page=N so the back button returns a reader to the page they were on
     *  after they open a pattern. Filter changes replace rather than push, or
     *  every keystroke would land in the history. */
    const syncUrl = (mode: 'push' | 'replace') => {
      const url = new URL(location.href);
      if (page > 1) url.searchParams.set('page', String(page));
      else url.searchParams.delete('page');
      if (mode === 'push') history.pushState({ page }, '', url);
      else history.replaceState({ page }, '', url);
    };

    const goTo = (n: number) => {
      if (n === page) return;
      page = n;
      apply();
      syncUrl('push');
      grid.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
    };

    const refilter = () => {
      page = 1;
      apply();
      syncUrl('replace');
    };

    numsEl?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-page]');
      if (btn) goTo(Number(btn.dataset.page));
    });
    prevBtn?.addEventListener('click', () => goTo(Math.max(1, page - 1)));
    nextBtn?.addEventListener('click', () => goTo(page + 1));

    window.addEventListener('popstate', () => {
      page = readPage();
      apply();
    });

    search?.addEventListener('input', refilter);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeTag = chip.dataset.tag || '';
        chips.forEach((c) => {
          const on = c === chip;
          c.classList.toggle('is-on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        refilter();
      });
    });

    clearBtn?.addEventListener('click', () => {
      if (search) search.value = '';
      activeTag = '';
      chips.forEach((c, i) => {
        c.classList.toggle('is-on', i === 0);
        c.setAttribute('aria-pressed', String(i === 0));
      });
      refilter();
      search?.focus();
    });

    apply();
  }
</script>
