---
import { ADSENSE_CLIENT } from '../data/analytics';
import { type Lang } from '../i18n/utils';

// One hand-placed AdSense display unit. Renders nothing until the unit id
// exists in AdSense (Ads → By ad unit), so a page never shows an empty box.
// Placed only where a stray tap cannot land on it: never beside a download
// or "open in app" button.
interface Props { slot: string; lang: Lang; }
const { slot, lang } = Astro.props;
const label = lang === 'es' ? 'Publicidad' : 'Advertisement';
---
{ADSENSE_CLIENT && slot && (
  <aside class="ad-unit" aria-label={label} data-reveal>
    <span class="ad-label">{label}</span>
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}

<style>
  .ad-unit { margin: 2rem 0; min-height: 120px; }
  .ad-label { display: block; font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.4rem; }
  /* Google marks a slot it could not fill; collapse it instead of leaving a gap. */
  .ad-unit:has(ins[data-ad-status='unfilled']) { display: none; }
</style>
