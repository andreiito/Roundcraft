---
import Base from '../layouts/Base.astro';
import HomeSchema from '../components/HomeSchema.astro';
import Home from '../components/Home.astro';
const description = "The crochet app for makers who sell. Count rows, track your time and turn both into a fair price. Free to start, with a 7-day Premium trial.";
---
<Base
  title="RoundCraft — Finish every piece knowing what to charge"
  description={description}
  lang="en"
>
  <HomeSchema lang="en" description={description} />
  <Home lang="en" />
</Base>
