---
import Base from '../../layouts/Base.astro';
import HomeSchema from '../../components/HomeSchema.astro';
import Home from '../../components/Home.astro';
const description = "La app de crochet para quien vende su trabajo. Cuenta vueltas, cronometra tu tiempo y convierte ambos en un precio justo. Gratis para empezar, con prueba Premium de 7 días.";
